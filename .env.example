# SalesVoice AI - local environment template
# Copy this file to .env and edit .env with your own values.
# Never paste your API key into chat, source code, or commits.
# Never commit the real .env file.

# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Placeholder only - model availability is NOT verified by this file.
# Check the official model list before using a name:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=your_model_name_here

# Optional server settings (safe defaults are used if these are missing).
# Keep the host on localhost: the browser only allows microphone access
# on http://127.0.0.1 / http://localhost or on an https:// page.
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=false
# GEMINI_TIMEOUT_SECONDS=30
# MAX_HISTORY_MESSAGES=24

# Optional local storage settings.
# The SQLite call history and the recordings folder are excluded from Git.
# DATABASE_PATH=instance/salesvoice.db
# RECORDINGS_DIR=recordings
# RECORDING_MAX_BYTES=26214400
